ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# 선택: 비용/품질 조절용. 비워두면 claude-sonnet-5 / 480으로 동작.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=480
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 브라우저 푸시 알림용 — `npx web-push generate-vapid-keys`로 생성
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_SUBJECT=mailto:example@ai-lover.local

# /api/cron/reconnect-check 호출을 보호하는 임의의 비밀 문자열 (예: openssl rand -hex 24)
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 개발자 모드 진입용 비밀 문자열. /?dev=이값 으로 접속하면 이 브라우저에서 리밋 우회/개발용 UI가 켜짐.
DEV_MODE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
